<?xml version="1.0"?>
<phpunit bootstrap="tests/php/bootstrap.php" colors="true" convertErrorsToExceptions="true" convertNoticesToExceptions="true" convertWarningsToExceptions="true">
  <testsuites>
    <testsuite name="match-music">
      <directory suffix="Test.php">tests/php</directory>
    </testsuite>
  </testsuites>
</phpunit>
